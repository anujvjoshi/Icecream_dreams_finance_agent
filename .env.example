# Data source: excel (default) or google_sheets
SOURCE_TYPE=excel

# Workbook path can be absolute or relative to this project folder
WORKBOOK_PATH=Ice Cream Dreams - Expense Report.xlsx

# Optional: exact worksheet tab containing the expense ledger
LEDGER_SHEET=Monhtly_Expense

# Required only when SOURCE_TYPE=google_sheets
SPREADSHEET_ID=

# Daily scheduled refresh
SCHEDULE_TIME=09:00
TIMEZONE=Asia/Kolkata

# Dashboard live-refresh interval in seconds
DASHBOARD_REFRESH_SECONDS=300

# Financial year starts in April (India)
FINANCIAL_YEAR_START_MONTH=4

# Optional high-expense warning threshold in INR. Leave blank to disable.
HIGH_EXPENSE_THRESHOLD=
